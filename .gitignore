# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Milestone 10 — auto-generated credential-encryption master key. Never commit:
# losing it just means re-entering Admin Panel credentials, but committing it
# would defeat the encryption entirely.
.encryption-key
# Fix (2026-07-27) — same key, new writable-in-Docker location; see
# lib/security/master-key.ts.
/.data

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated client
/src/generated/prisma

# MockStorageProvider's local-disk backend (dev/single-instance only — see
# src/lib/providers/storage/mock.provider.ts)
/public/uploads

# local Prisma consistency-check scratch files — not needed outside dev machine
prisma/_consistency_test*
